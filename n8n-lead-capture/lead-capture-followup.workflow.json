{
  "name": "Lead capture: form webhook -> Google Sheets -> OpenAI follow-up -> Gmail -> Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contact-form",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1f0c0e1-0001-4000-8000-000000000001",
      "name": "Contact form (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "contact-form-lead-capture"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "lead_id", "value": "={{ $json.body.submission_id || $json.body.id || $now.toMillis() }}", "type": "string" },
            { "id": "f2", "name": "name", "value": "={{ ($json.body.name || $json.body.full_name || 'there').toString().trim() }}", "type": "string" },
            { "id": "f3", "name": "email", "value": "={{ ($json.body.email || '').toString().trim().toLowerCase() }}", "type": "string" },
            { "id": "f4", "name": "phone", "value": "={{ ($json.body.phone || '').toString().trim() }}", "type": "string" },
            { "id": "f5", "name": "message", "value": "={{ ($json.body.message || $json.body.comment || '').toString().trim() }}", "type": "string" },
            { "id": "f6", "name": "received_at", "value": "={{ $now.toISO() }}", "type": "string" },
            { "id": "f7", "name": "business_name", "value": "YOUR BUSINESS NAME", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1f0c0e1-0002-4000-8000-000000000002",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.email }}",
              "rightValue": "@",
              "operator": { "type": "string", "operation": "contains" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c0e1-0003-4000-8000-000000000003",
      "name": "Has email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "YOUR_SPREADSHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Leads", "mode": "name" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [], "schema": [] },
        "options": {}
      },
      "id": "a1f0c0e1-0004-4000-8000-000000000004",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [740, -120]
    },
    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list", "cachedResultName": "gpt-4o-mini" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "=You write short follow-up emails for a small business called {{ $('Normalize lead').item.json.business_name }}. Rules: 3 to 5 sentences, plain text, no subject line, no markdown, no placeholders, no promises about prices or dates. Thank the person by name, show that you read their message by referring to one concrete detail from it, say that someone will reply within one business day, sign off with the business name. Write in the same language as the message."
            },
            {
              "content": "=Lead name: {{ $('Normalize lead').item.json.name }}\nMessage from the contact form:\n{{ $('Normalize lead').item.json.message }}"
            }
          ]
        },
        "options": { "temperature": 0.4 }
      },
      "id": "a1f0c0e1-0005-4000-8000-000000000005",
      "name": "Write follow-up (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [980, -120]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Normalize lead').item.json.email }}",
        "subject": "=Thanks for contacting {{ $('Normalize lead').item.json.business_name }}",
        "emailType": "text",
        "message": "={{ $json.message.content }}",
        "options": { "appendAttribution": false }
      },
      "id": "a1f0c0e1-0006-4000-8000-000000000006",
      "name": "Send follow-up (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1220, -120]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=New lead ({{ $('Normalize lead').item.json.lead_id }})\nName: {{ $('Normalize lead').item.json.name }}\nEmail: {{ $('Normalize lead').item.json.email }}\nPhone: {{ $('Normalize lead').item.json.phone || '-' }}\nMessage: {{ $('Normalize lead').item.json.message }}\nFollow-up email: sent\nReceived: {{ $('Normalize lead').item.json.received_at }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1f0c0e1-0007-4000-8000-000000000007",
      "name": "Notify me (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1460, -120]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=Lead WITHOUT a valid email, no follow-up sent ({{ $json.lead_id }})\nName: {{ $json.name }}\nPhone: {{ $json.phone || '-' }}\nMessage: {{ $json.message }}\nReceived: {{ $json.received_at }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1f0c0e1-0008-4000-8000-000000000008",
      "name": "Notify me (no email)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [740, 160]
    }
  ],
  "connections": {
    "Contact form (webhook)": { "main": [[{ "node": "Normalize lead", "type": "main", "index": 0 }]] },
    "Normalize lead": { "main": [[{ "node": "Has email?", "type": "main", "index": 0 }]] },
    "Has email?": {
      "main": [
        [{ "node": "Save to Google Sheets", "type": "main", "index": 0 }],
        [{ "node": "Notify me (no email)", "type": "main", "index": 0 }]
      ]
    },
    "Save to Google Sheets": { "main": [[{ "node": "Write follow-up (OpenAI)", "type": "main", "index": 0 }]] },
    "Write follow-up (OpenAI)": { "main": [[{ "node": "Send follow-up (Gmail)", "type": "main", "index": 0 }]] },
    "Send follow-up (Gmail)": { "main": [[{ "node": "Notify me (Telegram)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
}
